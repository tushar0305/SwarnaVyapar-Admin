# Supabase Configuration (from main SwarnaVyapar project)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
# Server-only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Admin Configuration
NEXT_PUBLIC_APP_URL=http://localhost:9003
NEXT_PUBLIC_MAIN_APP_URL=http://localhost:9002

# Security (comma-separated IPs; empty = allow all for local dev)
ADMIN_IP_WHITELIST=127.0.0.1,::1
# Idle session timeout in seconds (0 = disabled). Default in code is 1800 if unset.
ADMIN_SESSION_TIMEOUT=1800
# Required in production for signed idle-session cookies (min 16 chars).
# Local/dev may fall back to SUPABASE_SERVICE_ROLE_KEY if this is unset.
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret
# Auth bypass is disabled in code. Login with a real super_admins account is always required.

# Optional: Analytics
NEXT_PUBLIC_GA_ID=

# Optional: Sentry
SENTRY_DSN=

# WhatsApp Cloud API — platform number used to message shop owners
# From Meta Developer → WhatsApp → API Setup
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_DISPLAY_PHONE=
WHATSAPP_BUSINESS_NAME=SwarnaVyapar
WHATSAPP_OPS_TEMPLATE=sv_admin_setup

# SerpApi — jewellery shop discovery (Google Maps). Free plan = 250 searches/mo.
# Server-only — never expose to the browser. https://serpapi.com/manage-api-key
SERPAPI_KEY=

# Gemini — AI Hinglish sales scripts for discovered leads (optional)
# Server-only. Map area picker uses OpenStreetMap/Nominatim and does NOT use this key.
# Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional override (default gemini-3.8-flash)
# GEMINI_SALES_MODEL=gemini-3.8-flash
# Alias also accepted: GOOGLE_GENERATIVE_AI_API_KEY=

